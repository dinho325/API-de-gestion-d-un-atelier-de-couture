# Copiez ce fichier en ".env" puis adaptez les valeurs. Ne committez JAMAIS le .env.

# --- PostgreSQL (utilisé par docker compose) ---
POSTGRES_USER=atelier
POSTGRES_PASSWORD=change-me
POSTGRES_DB=atelier

# --- API ---
# En local (sans Docker) : base accessible sur localhost.
# Avec docker compose, cette valeur est reconstruite automatiquement.
DATABASE_URL=postgresql+psycopg2://atelier:change-me@localhost:5432/atelier
# Générer une clé : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=remplacez-par-une-longue-chaine-aleatoire
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Premier administrateur (créé par python -m app.seed) ---
ADMIN_EMAIL=patron@atelier.sn
ADMIN_PASSWORD=ChangezMoi2026
ADMIN_NOM=Mamadou (patron)

# --- Comptes de démonstration accueil + tailleur (true/false) ---
SEED_DEMO_USERS=true
DEMO_PASSWORD=Demo12345
